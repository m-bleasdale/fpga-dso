set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:00:42  AUGUST 18, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (SystemVerilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dso_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dds/phase_accumulator.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dds/lut/sine_lut.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dds/dds_gain.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dds/dds_sample_clk.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dds/dds_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dac_if.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/uart/uart_tx.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/uart/uart_rx.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/uart/uart_cmd.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adc/adc_capture.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adc/adc_decimate.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adc/adc_trigger.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adc/sample_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adc/capture_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/top.sv
set_global_assignment -name MIF_FILE rtl/dds/lut/sine_lut.mif
set_global_assignment -name SDC_FILE DSOscilloscope.sdc
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

#pin assignments, EP4CE6E22C8N
#clk: 50 MHz oscillator, rst_n: push button (active LOW)
#uart: USB-UART to laptop, adc/dac: expansion header, leds: on board (active LOW)
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_25 -to rst_n
set_location_assignment PIN_115 -to uart_rx_in
set_location_assignment PIN_114 -to uart_tx_out
set_location_assignment PIN_28 -to adc_data[0]
set_location_assignment PIN_30 -to adc_data[1]
set_location_assignment PIN_31 -to adc_data[2]
set_location_assignment PIN_32 -to adc_data[3]
set_location_assignment PIN_33 -to adc_data[4]
set_location_assignment PIN_34 -to adc_data[5]
set_location_assignment PIN_38 -to adc_data[6]
set_location_assignment PIN_39 -to adc_data[7]
set_location_assignment PIN_42 -to adc_convst_n
set_location_assignment PIN_43 -to adc_cs_n
set_location_assignment PIN_44 -to adc_rd_n
set_location_assignment PIN_46 -to dac_cs_n
set_location_assignment PIN_49 -to dac_sck
set_location_assignment PIN_50 -to dac_mosi
set_location_assignment PIN_51 -to dac_ldac_n
set_location_assignment PIN_87 -to led_trig_n
set_location_assignment PIN_86 -to led_dac_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to *
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to uart_rx_in
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to rst_n
